# Copy to .env and adjust. Never commit real credentials.
# Keep comments on their own lines: an empty value followed by "# ..." is read as the comment.

# --- docker compose (server deployment) ---
# Host port for the API, e.g. 4000
CTP_PORT=8000
# Use 127.0.0.1 when a reverse proxy (nginx) sits in front
CTP_BIND=0.0.0.0
# PostgreSQL password
CTP_DB_PASSWORD=change-me
# Set to require the X-API-Key header on /v1 endpoints (empty = no auth)
CTP_API_KEY=

# --- local run without Docker ---
CTP_DATABASE_URL=sqlite:///./data/ctpipeline.db
CTP_STORAGE_ROOT=./data/objects
CTP_CONFIGS_DIR=./configs
CTP_LOG_LEVEL=INFO
CTP_MAX_ATTEMPTS=3
CTP_RETRY_BACKOFF_SECONDS=5
CTP_STALE_JOB_SECONDS=900
# Run a worker thread inside the API process (development only)
CTP_EMBEDDED_WORKER=false
CTP_DEVICE=cpu
