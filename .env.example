# Copy to .env for local runs. Never commit real credentials.
CTP_DATABASE_URL=sqlite:///./data/ctpipeline.db
# CTP_DATABASE_URL=postgresql+psycopg://ctp:ctp@localhost:5432/ctpipeline
CTP_STORAGE_ROOT=./data/objects
CTP_CONFIGS_DIR=./configs
CTP_LOG_LEVEL=INFO
# Set to require the X-API-Key header on /v1 endpoints.
CTP_API_KEY=
CTP_MAX_ATTEMPTS=3
CTP_RETRY_BACKOFF_SECONDS=5
CTP_STALE_JOB_SECONDS=900
# Run a worker thread inside the API process (development only).
CTP_EMBEDDED_WORKER=false
CTP_DEVICE=cpu
